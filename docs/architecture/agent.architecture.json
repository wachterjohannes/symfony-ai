  "cards": [
    {
      "dot": "violet",
      "title": "Orchestration",
      "items": [
        "Agent is the entry point; Runner drives the model/tool-call loop up to maxToolCalls",
        "call() returns a lazy Execution before the model is invoked"
      ]
    },
    {
      "dot": "cyan",
      "title": "Extensibility",
      "items": [
        "Input/output processors form a middleware-like chain (system prompt, model override, memory)",
        "Toolbox executes tool calls the model requested, fault-tolerant"
      ]
    },
    {
      "dot": "slate",
      "title": "Optional features",
      "items": [
        "Memory needs Store only when using the embedding-based provider",
        "MultiAgent hands conversations off between specialized agents"
      ]
    }
  ]
