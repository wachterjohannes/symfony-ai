{
    "name": "symfony/ai-platform-webless-demo",
    "description": "Console-only app using the AI platform bundles WITHOUT symfony/framework-bundle",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/ai-open-ai-platform": "^1.0",
        "symfony/ai-platform": "^1.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../",
            "options": {
                "versions": {
                    "symfony/ai-platform": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../../src/Bridge/OpenAi",
            "options": {
                "versions": {
                    "symfony/ai-open-ai-platform": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../../src/Bridge/OpenResponses",
            "options": {
                "versions": {
                    "symfony/ai-open-responses-platform": "1.0.0"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
