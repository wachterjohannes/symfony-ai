  "cards": [
    {
      "dot": "violet",
      "title": "Discovery & wiring",
      "items": [
        "Extension Discovery reads composer.json's extra.ai-mate key to find installed extensions",
        "Capability Discovery reflects #[MateTool]/#[MateResource] methods into callable definitions"
      ]
    },
    {
      "dot": "cyan",
      "title": "Extensibility",
      "items": [
        "Bridges (Symfony, Monolog) are first-party packages built on the same extension contract",
        "Extensions and bridges can each ship their own Agent Skill, installed under mate- prefixed folders"
      ]
    },
    {
      "dot": "slate",
      "title": "Standalone",
      "items": [
        "Does not use MCP and does not integrate with the AI Bundle",
        "Talks to coding agents only through the CLI and its generated instruction files"
      ]
    }
  ]
