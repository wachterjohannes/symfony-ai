{% set nonEmptyGroups = groups|filter(group => group.items|length > 0) %}

{% if nonEmptyGroups|length > 0 %}
    <div class="architecture-cross-links">
        {% for group in nonEmptyGroups %}
            <div class="architecture-cross-links-group">
                <span class="architecture-cross-links-label">{{ group.label }}</span>
                {% for item in group.items %}
                    <a class="architecture-cross-link-chip" href="{{ item.url }}">
                        {{ item.title }} <span aria-hidden="true">&rarr;</span>
                    </a>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endif %}
