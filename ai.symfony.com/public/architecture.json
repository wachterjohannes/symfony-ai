        "views": [],
        "cards": [
            {
                "title": "Wiring",
                "items": [
                    "Only symfony/ai-platform is a hard dependency; Agent, Store and MCP Bundle are all optional, detected via require-dev packages",
                    "Compiler passes register #[AsTool]/#[AsInputProcessor]/#[AsOutputProcessor] into the Agent's toolbox and processor chain"
                ]
            },
            {
                "title": "Cross-cutting",
                "items": [
                    "#[IsGrantedTool] gates tool execution behind Symfony Security",
                    "Profiler collects AI interactions and token usage for the debug toolbar"
                ]
            },
            {
                "title": "MCP integration",
                "items": [
                    "ConnectionToolset reuses an existing MCP Bundle client connection instead of opening a second one",
                    "This is separate from MCP Bundle's own server/client role, see the MCP Bundle diagram"
                ]
            }
        ],
