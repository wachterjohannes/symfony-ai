    {
      "dot": "violet",
      "title": "Core components",
      "items": [
        "Agent orchestrates model calls and tool execution",
        "Platform is the unified interface to AI providers",
        "Store abstracts vector database indexing and retrieval"
      ]
    },
    {
      "dot": "cyan",
      "title": "Bundles",
      "items": [
        "AI Bundle wires Platform/Agent/Store into a Symfony app",
        "MCP Bundle exposes the app's own tools as an MCP server"
      ]
    },
