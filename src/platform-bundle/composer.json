{
    "name": "symfony/ai-platform-bundle",
    "description": "Symfony bundle for the AI Platform component, usable without symfony/framework-bundle",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": ["ai", "bundle", "platform"],
    "authors": [
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/ai-platform": "^1.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53",
        "symfony/ai-open-ai-platform": "^1.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0"
    },
    "suggest": {
        "symfony/console": "To use the ai:platform:invoke command",
        "symfony/http-client": "Used as default HTTP client by bridge bundles when no \"http_client\" service exists"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\PlatformBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../.phpstan/",
            "Symfony\\AI\\PlatformBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
