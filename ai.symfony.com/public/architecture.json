        "cards": [
            {
                "title": "Entry point",
                "items": [
                    "Platform is the single call surface: invoke() takes a Model, a MessageBag or prompt, and options",
                    "Agent, Chat and Store all require Platform"
                ]
            },
            {
                "title": "Request pipeline",
                "items": [
                    "Contract normalizes messages, tools and options into a provider payload",
                    "Result converts the raw provider response back into a typed result"
                ]
            },
            {
                "title": "Testing bridges",
                "items": [
                    "Record-and-replay scaffolding in Test/Replay/ pins result converters against real provider response shapes",
                    "Replay runs in CI without credentials; recording is a manual, local-only step"
                ]
            }
        ],
