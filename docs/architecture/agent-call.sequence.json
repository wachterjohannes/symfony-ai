    },
    {
      "participant": "platform",
      "from": 466,
      "to": 520,
      "type": "cloud"
    },
    {
      "participant": "tools",
      "from": 580,
      "to": 634,
      "type": "backend"
    },
    {
      "participant": "output",
      "from": 790,
      "to": 844,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Lazy by design",
      "items": [
        "call() returns an Execution before the model is invoked",
        "Nothing runs until it is iterated or getContent()/getResult() is called",
        "Input processors only run on that first iteration"
      ]
    },
    {
      "dot": "orange",
      "title": "Bounded tool loop",
      "items": [
        "Each round: model request, optional stream, tool execution",
        "Repeats until the model answers without requesting a tool",
        "maxToolCalls (default 50) caps rounds, else MaxIterationsExceededException"
      ]
    },
    {
      "dot": "emerald",
      "title": "Progress surfaces live",
      "items": [
        "model_request and streamed delta updates bubble up through the Execution",
        "The final ResultUpdate is the last value the caller observes",
        "Output processors run once, after the loop exits"
      ]
    }
  ]
}
